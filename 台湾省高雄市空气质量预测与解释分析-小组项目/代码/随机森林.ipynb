def plot_site_predictions(results):
    """绘制5个站点的预测结果拟合图（图2-6）"""
    print("  生成5个站点预测结果拟合图...")

    fig, axes = plt.subplots(2, 3, figsize=(15, 10))
    axes = axes.flatten()

    # 站点颜色映射
    station_colors = {
        'Xiaogang': '#1f77b4',
        'Linyuan': '#ff7f0e',
        'Qianjin': '#2ca02c',
        'Zuoying': '#d62728',
        'Meinong': '#9467bd'
    }

    station_names = ['Xiaogang', 'Linyuan', 'Qianjin', 'Zuoying', 'Meinong']
    plot_titles = ['Xiaogang某样本拟合图', 'Linyuan某样本拟合图',
                   'Qianjin某样本拟合图', 'Zuoying某样本拟合图', 'Meinong某样本拟合图']

    for idx, (station, title) in enumerate(zip(station_names, plot_titles)):
        ax = axes[idx]

        # 查找该站点的结果
        station_res = None
        for res in results:
            if res['station'] == station:
                station_res = res
                break

        if station_res and station_res.get('y_test_sample') is not None and station_res.get('y_test_pred_sample') is not None:
            # 获取真实值和预测值
            actual_aqi = station_res['y_test_sample']
            predicted_aqi = station_res['y_test_pred_sample']

            # 确保长度一致
            min_len = min(len(actual_aqi), len(predicted_aqi), FORECAST_HORIZON)
            hours = np.arange(1, min_len + 1)
            actual_aqi = actual_aqi[:min_len]
            predicted_aqi = predicted_aqi[:min_len]

            # 绘制曲线
            ax.plot(hours, actual_aqi, color=station_colors[station],
                   linewidth=2, marker='o', markersize=4, label='实际AQI值')
            ax.plot(hours, predicted_aqi, color=station_colors[station],
                   linewidth=2, linestyle='--', marker='s',
                   markersize=4, alpha=0.7, label='模型预测AQI值')

            # 设置图形属性
            ax.set_xlabel('预测时长 (小时)', fontsize=10)
            ax.set_ylabel('AQI', fontsize=10)
            ax.set_title(title, fontsize=12, fontweight='bold')
            ax.grid(True, alpha=0.3)
            ax.legend(loc='best', fontsize=9)

            # 设置x轴刻度
            ax.set_xticks([1, 6, 12, 18, 24])
            ax.set_xticklabels(['1h', '6h', '12h', '18h', '24h'])

            # 添加R²文本
            r2_value = station_res['r2']
            ax.text(0.05, 0.95, f'R² = {r2_value:.4f}', transform=ax.transAxes,
                   fontsize=10, verticalalignment='top',
                   bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))

        else:
            ax.text(0.5, 0.5, f'无{station}站点数据',
                   ha='center', va='center', transform=ax.transAxes,
                   fontsize=12)
            ax.set_title(title, fontsize=12, fontweight='bold')

    # 隐藏最后一个子图（如果有6个子图）
    if len(axes) > 5:
        axes[-1].axis('off')

    plt.suptitle('5个站点24小时AQI预测结果拟合对比', fontsize=14, fontweight='bold')
    plt.tight_layout()
    plt.savefig('5_stations_aqi_predictions.png', dpi=300, bbox_inches='tight')
    plt.savefig('5_stations_aqi_predictions.svg', format='svg', bbox_inches='tight')
    plt.close()
    print("    5个站点预测结果拟合图已保存为 '5_stations_aqi_predictions.png' 和 '5_stations_aqi_predictions.svg'")

def plot_r2_trend_by_period(results):
    """绘制不同时间段R²趋势折线图（图7）"""
    print("  生成不同时间段R²趋势折线图...")

    # 从结果中提取数据
    period_data = {}

    for res in results:
        station = res['station']
        period_metrics = res['period_metrics']

        if station not in period_data:
            period_data[station] = {}

        for period, metrics in period_metrics.items():
            period_data[station][period] = metrics['r2']

    # 定义时间段顺序
    periods = ['1-6h', '7-12h', '13-18h', '19-24h']
    period_labels = ['1-6小时', '7-12小时', '13-18小时', '19-24小时']

    # 站点颜色
    station_colors = {
        'Xiaogang': '#1f77b4',
        'Linyuan': '#ff7f0e',
        'Qianjin': '#2ca02c',
        'Zuoying': '#d62728',
        'Meinong': '#9467bd'
    }

    # 创建图形
    fig, ax = plt.subplots(figsize=(10, 6))

    # 绘制每个站点的折线
    x_positions = np.arange(len(periods))

    for station in period_data:
        if station in station_colors:
            r2_values = [period_data[station].get(period, 0) for period in periods]

            # 绘制折线
            ax.plot(x_positions, r2_values,
                   color=station_colors[station],
                   linewidth=2.5,
                   marker='o',
                   markersize=8,
                   label=station)

            # 添加数据标签
            for i, (x, y) in enumerate(zip(x_positions, r2_values)):
                ax.text(x, y + 0.01, f'{y:.3f}',
                       ha='center', va='bottom',
                       fontsize=9, fontweight='bold',
                       color=station_colors[station])

    # 设置图形属性
    ax.set_xlabel('预测时间段', fontsize=12)
    ax.set_ylabel('R²值', fontsize=12)
    ax.set_title('不同时间段随机森林模型R²预测效果',
                 fontsize=14, fontweight='bold')

    ax.set_xticks(x_positions)
    ax.set_xticklabels(period_labels, fontsize=11)

    # 设置y轴范围
    ax.set_ylim(0.45, 0.85)
    ax.set_yticks(np.arange(0.45, 0.86, 0.05))
    ax.set_yticklabels([f'{tick:.2f}' for tick in np.arange(0.45, 0.86, 0.05)], fontsize=10)

    # 添加网格
    ax.grid(True, alpha=0.3, linestyle='--')

    # 添加图例
    ax.legend(loc='lower left', fontsize=10, framealpha=0.9)

    # 添加平均R²线
    avg_r2_by_period = []
    for period in periods:
        period_r2_values = [period_data[station].get(period, 0) for station in period_data]
        avg_r2 = np.mean(period_r2_values) if period_r2_values else 0
        avg_r2_by_period.append(avg_r2)

    ax.plot(x_positions, avg_r2_by_period, 'k--', linewidth=2, alpha=0.5, label='平均R²')

    # 添加平均R²数据标签
    for i, (x, y) in enumerate(zip(x_positions, avg_r2_by_period)):
        ax.text(x, y - 0.02, f'{y:.3f}',
               ha='center', va='top',
               fontsize=9, fontweight='bold',
               color='black', bbox=dict(boxstyle='round,pad=0.2', facecolor='white', alpha=0.8))

    # 添加趋势分析文本
    trend_text = "趋势分析：所有站点的R²值均随预测时长的增加呈递减趋势\n" \
                 "1-6h时间段R²值最高，说明短期预测精度最优\n" \
                 "19-24h时间段R²值最低，长期预测因误差累积导致精度下降"

    ax.text(0.02, 0.02, trend_text, transform=ax.transAxes,
           fontsize=9, verticalalignment='bottom',
           bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.8))

    plt.tight_layout()
    plt.savefig('r2_trend_by_period.png', dpi=300, bbox_inches='tight')
    plt.savefig('r2_trend_by_period.svg', format='svg', bbox_inches='tight')
    plt.close()
    print("    R²趋势折线图已保存为 'r2_trend_by_period.png' 和 'r2_trend_by_period.svg'")

# 生成图表
if results:
    try:
        plot_site_predictions(results)
        plot_r2_trend_by_period(results)
        print(f"\n{datetime.now().strftime('%H:%M:%S')} - 图表生成完成!")
        print("  生成的文件:")
        print("  - 5_stations_aqi_predictions.png/.svg: 5个站点预测结果拟合图")
        print("  - r2_trend_by_period.png/.svg: R²趋势折线图")
    except Exception as e:
        print(f"  生成图表时出错: {e}")
else:
