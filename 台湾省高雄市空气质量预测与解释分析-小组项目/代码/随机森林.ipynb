                row[2], max_col_lengths[2]
            ))
            print("|{}+{}+{}|".format(
                "-" * (max_col_lengths[0] + 2),
                "-" * (max_col_lengths[1] + 2),
                "-" * (max_col_lengths[2] + 2)
            ))
