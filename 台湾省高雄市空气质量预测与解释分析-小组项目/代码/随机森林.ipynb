#%%
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import r2_score, mean_squared_error
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA  # PCA降维
from sklearn.impute import SimpleImputer
import warnings

# 忽略性能警告
warnings.simplefilter("ignore", category=pd.errors.PerformanceWarning)


# ---------------------- 0. 一些配置 ----------------------
target_site = "Zuoying"                     # 目标站点：要预测谁
neighbor_stations = ["Meinong", "Linyuan","Qianjin","Xiaogang"]  # 邻居站点列表
target_col = "aqi"                          # 预测目标

# ---------------------- 1. 数据加载与预处理 ----------------------
df = pd.read_csv("D:/桌面/高雄市空气污染源数据.csv")  
df["date"] = pd.to_datetime(df["date"])
df = df.sort_values(["sitename", "date"]).reset_index(drop=True)

# 只保留 目标站 + 邻居站，这一步本身就能大幅减小数据量
used_sites = [target_site] + neighbor_stations
df = df[df["sitename"].isin(used_sites)].reset_index(drop=True)

# 数值列
numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()

# 去掉一些明显没必要做滞后/滚动的列（经纬度、id 等）
drop_numeric = ["longitude", "latitude", "siteid"]
numeric_cols = [c for c in numeric_cols if c not in drop_numeric]

# 只保留：date、sitename、数值列（其他非数值列先扔掉）
df = df[["date", "sitename"] + numeric_cols]

# 强制转换为数值 + 填缺失
for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors="coerce")

# 统一用 float32，直接砍半内存
df[numeric_cols] = df[numeric_cols].astype("float32")

# 按站点填充缺失值（仅数值列）
df[numeric_cols] = df.groupby("sitename")[numeric_cols].transform(
    lambda x: x.fillna(x.median())
)

# 时间特征编码（对所有站都加，后面函数里只用目标站那一部分）
df["hour"] = df["date"].dt.hour
df["month"] = df["date"].dt.month
df["dayofweek"] = df["date"].dt.dayofweek
df["hour_sin"] = np.sin(2 * np.pi * df["hour"] / 24)
df["hour_cos"] = np.cos(2 * np.pi * df["hour"] / 24)
df["month_sin"] = np.sin(2 * np.pi * df["month"] / 12)
df["month_cos"] = np.cos(2 * np.pi * df["month"] / 12)

# ---------------------- 2. 轻量化特征工程 ----------------------
def create_light_72h_window_table(
    df_all,
    numeric_cols,
    target_site="Zuoying",
    target_col="aqi",
    window_hours=72,
    neighbor_stations=None,
):
    """
    只对【目标站】做 72h 滞后 + 窗口统计；
    邻居站只在 t 时刻提供 pm2.5 / windspeed / winddirection。
    """
    if neighbor_stations is None:
        neighbor_stations = []

    # ---- 2.1 只取目标站数据（核心省内存的地方之一） ----
    wide_df = (
        df_all[df_all["sitename"] == target_site]
        .sort_values("date")
        .reset_index(drop=True)
    )

    # 只对少量关键物理量做滞后和窗口统计，而不是对所有 numeric_cols
    # 你可以按作业要求改这个列表
    base_feats = [
        c
        for c in ["pm2.5", "pm10", "so2", "co", "o3", "no2", "nox", "no", target_col]
        if c in numeric_cols
    ]
    # 移除 target_col 本身（防止泄漏未来信息）
    base_feats = [c for c in base_feats if c != target_col]

    # 关键滞后点，而非 1~72 全量
    key_lags = [1, 3, 6, 12, 24, 48, 72]

    # ---- 2.2 为目标站生成滞后特征 + 72h统计 ----
    for feat in base_feats:
        # 滞后
        for lag in key_lags:
            wide_df[f"{feat}_lag{lag}"] = wide_df[feat].shift(lag)
        # 72h 窗口统计
        wide_df[f"{feat}_72h_mean"] = (
            wide_df[feat].shift(1).rolling(window=window_hours).mean()
        )
        wide_df[f"{feat}_72h_std"] = (
            wide_df[feat].shift(1).rolling(window=window_hours).std()
        )

    # ---- 2.3 邻居站 t 时刻特征 ----
    for station in neighbor_stations:
        # 只取该站的少量关键变量
        cols_for_nb = [c for c in ["pm2.5", "windspeed", "winddirection"] if c in df_all.columns]
        if not cols_for_nb:
            continue
        df_nb = (
            df_all[df_all["sitename"] == station][["date"] + cols_for_nb]
            .sort_values("date")
        )
        rename_dict = {c: f"{station}_{c}" for c in cols_for_nb}
        df_nb = df_nb.rename(columns=rename_dict)
        wide_df = wide_df.merge(df_nb, on="date", how="left")

    # ---- 2.4 清理缺失 + 选特征列 ----
    wide_df = wide_df.dropna().reset_index(drop=True)

    # 所有数值型且不是 date/sitename/target 的列都作为特征
    X_cols = [
        col
        for col in wide_df.columns
        if col not in ["date", "sitename", target_col]
        and np.issubdtype(wide_df[col].dtype, np.number)
    ]

    return wide_df, X_cols


# 生成轻量化72小时窗口特征表（只针对 target_site）
wide_df, X_cols = create_light_72h_window_table(
    df,
    numeric_cols=numeric_cols,
    target_site=target_site,
    target_col=target_col,
    window_hours=72,
    neighbor_stations=neighbor_stations,
)

# ---------------------- 3. 时间划分 + PCA降维 ----------------------
time_split_idx = int(0.8 * len(wide_df))
train_data = wide_df.iloc[:time_split_idx].reset_index(drop=True)
test_data = wide_df.iloc[time_split_idx:].reset_index(drop=True)

X_train, y_train = train_data[X_cols], train_data["aqi"]
X_test, y_test = test_data[X_cols], test_data["aqi"]

# ---------- 先用训练集的中位数填补缺失 ----------
imputer = SimpleImputer(strategy="median")
X_train_imputed = imputer.fit_transform(X_train)
X_test_imputed = imputer.transform(X_test)

# 特征标准化
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train_imputed)
X_test_scaled = scaler.transform(X_test_imputed)

# ========== 优化4：PCA降维（保留95%信息） ==========
pca = PCA(n_components=0.95, random_state=42)
X_train_pca = pca.fit_transform(X_train_scaled)
X_test_pca = pca.transform(X_test_scaled)
print(f"PCA降维后特征数：{X_train_pca.shape[1]}（原特征数：{X_train_scaled.shape[1]}）")
# ---------------------- 4. 轻量化随机森林模型 ----------------------
rf_model = RandomForestRegressor(
    n_estimators=100,
    max_depth=10,
    min_samples_split=10,
    random_state=42,
    n_jobs=-1,
    max_features="sqrt",
)
rf_model.fit(X_train_pca, y_train)

y_test_pred = rf_model.predict(X_test_pca)
print(f"测试集 R²：{r2_score(y_test, y_test_pred):.4f}")
print(f"测试集 RMSE：{np.sqrt(mean_squared_error(y_test, y_test_pred)):.4f}")

# ---------------------- 5. 未来72小时预测 ----------------------
def predict_next_72h_light(model, imputer, scaler, pca, last_72h_data, X_cols, numeric_cols,neighbor_stations,window_hours):

    """
    根据最后 72 小时的数据，滚动预测未来 72 小时 AQI。
    注意：这里同样只操作目标站那一小块数据，所以非常省内存。
    """
    predictions = []
    current_window = last_72h_data.copy().reset_index(drop=True)

    core_feats = [col for col in numeric_cols if col not in [target_col, "status"]]
    key_lags = [1, 3, 6, 12, 24, 48, 72]

    for hour in range(72):
        # 当前输入特征
        current_input = current_window.iloc[-1:][X_cols]

# 先用和训练时一样的 imputer 填补 NaN
        current_input_imputed = imputer.transform(current_input)

        current_input_scaled = scaler.transform(current_input_imputed)
        current_input_pca = pca.transform(current_input_scaled)


        # 预测当前小时 AQI
        pred_aqi = model.predict(current_input_pca)[0]
        predictions.append(pred_aqi)

        # 生成下一小时的时间信息
        last_date = current_window["date"].max()
        next_date = last_date + pd.Timedelta(hours=1)
        next_hour = next_date.hour
        next_month = next_date.month

        # 构建下一小时新行（只放必要字段，其他滞后/统计后面再补）
        next_row = pd.DataFrame(
            {
                "date": [next_date],
                "sitename": [current_window["sitename"].iloc[0]],
                target_col: [pred_aqi],
                "hour": [next_hour],
                "month": [next_month],
                "dayofweek": [next_date.dayofweek],
                "hour_sin": [np.sin(2 * np.pi * next_hour / 24)],
                "hour_cos": [np.cos(2 * np.pi * next_hour / 24)],
                "month_sin": [np.sin(2 * np.pi * next_month / 12)],
                "month_cos": [np.cos(2 * np.pi * next_month / 12)],
            }
        )

        # 更新关键滞后特征 + 72h统计
        for feat in core_feats:
            for lag in key_lags:
                if lag == 1:
                    val = (
                        current_window[feat].iloc[-1]
                        if feat in current_window.columns
                        else pred_aqi
                    )
                    next_row[f"{feat}_lag{lag}"] = val
                else:
                    prev_lag_col = (
                        f"{feat}_lag{lag-1}" if (lag - 1) in key_lags else f"{feat}_lag1"
                    )
                    if prev_lag_col in current_window.columns:
                        next_row[f"{feat}_lag{lag}"] = current_window[prev_lag_col].iloc[-1]
                    else:
                        next_row[f"{feat}_lag{lag}"] = np.nan

            # 72h 统计
            if feat in current_window.columns:
                window_feats = current_window[feat].tolist()[-window_hours + 1 :]
                window_feats.append(next_row[f"{feat}_lag1"].iloc[0])
                next_row[f"{feat}_72h_mean"] = np.mean(window_feats)
                next_row[f"{feat}_72h_std"] = np.std(window_feats)

        # 邻居站特征：这里简单假设未来72小时邻居站特征不变（可以按作业要求调整）
        for station in neighbor_stations:
            for feat in ["pm2.5", "windspeed", "winddirection"]:
                col = f"{station}_{feat}"
                if col in current_window.columns:
                    next_row[col] = current_window[col].iloc[-1]

        # 把缺失列补成 NaN，确保列对齐
        for col in X_cols:
            if col not in next_row.columns:
                next_row[col] = np.nan

        # 滚动窗口
        current_window = pd.concat(
            [current_window.iloc[1:], next_row[current_window.columns]], ignore_index=True
        )

    # 生成未来72小时时间索引
    start_date = last_72h_data["date"].max() + pd.Timedelta(hours=1)
    future_dates = pd.date_range(start=start_date, periods=72, freq="H")

    return pd.DataFrame({"date": future_dates, f"predicted_{target_col}": predictions})

# model, imputer, scaler, pca, last_72h_data, X_cols, numeric_cols,neighbor_stations,window_hours
# 取目标站最后 72 小时数据
last_72h_data = wide_df.tail(72)
future_72h_pred = predict_next_72h_light(
    rf_model, imputer, scaler, pca, last_72h_data, X_cols,numeric_cols,neighbor_stations,72,
)

print("\n未来72小时AQI预测（前10条）：")
print(future_72h_pred.head(10))
future_72h_pred.to_csv("future_72h_pred_light.csv", index=False)

