        ["特征工程", "核心特征数", f"{len(core_features)}"],
        ["", "时间特征", "小时、月份、星期、周期性编码、周末标志"],
        ["", "滞后特征", "1, 2, 3, 6, 12, 24, 48小时"],
        ["", "移动统计窗口", "12, 24, 48小时"],
        ["", "差分特征", "1小时差分, 24小时差分"],

        ["随机森林模型", "基模型", "RandomForestRegressor"],
        ["", "预测策略", "MultiOutputRegressor（多步预测）"],
        ["", "树的数量 (n_estimators)", "50"],
        ["", "最大深度 (max_depth)", "8"],
        ["", "最小分裂样本数", "15"],
        ["", "最小叶节点样本数", "8"],
        ["", "特征选择比例", "0.5"],

        ["特征处理", "标准化方法", "StandardScaler"],
        ["", "降维方法", "PCA (保留85%方差)"],
        ["", "NaN处理策略", "中位数填充 + 全局替换"],

        ["训练配置", "优化器", "- (随机森林内置)"],
        ["", "数据划分比例", "80%训练, 20%测试"],
        ["", "随机种子", "42"],
        ["", "并行计算", "启用 (n_jobs=-1)"],
        ["", "早停策略", "基于预测误差"],
    ]

    # 创建表格
    max_col_lengths = [0, 0, 0]
    for row in table_data:
        for i, cell in enumerate(row):
            max_col_lengths[i] = max(max_col_lengths[i], len(str(cell)))

    # 打印表格
    print("\n" + "="*100)
