# ===================== 11. 生成性能结果表格 =====================
def generate_performance_table(results):
    """生成模型性能结果表格"""

    if not results:
        print("无结果数据，跳过性能表格生成")
        return

    # 性能数据表头
    perf_table = [
        ["类别", "参数名称", "参数值"]
    ]

    # 添加整体性能指标
    if results:
        avg_rmse = np.mean([res['rmse'] for res in results])
        avg_mae = np.mean([res['mae'] for res in results])
        avg_r2 = np.mean([res['r2'] for res in results])

        perf_table.append(["整体性能", "平均RMSE", f"{avg_rmse:.4f}"])
        perf_table.append(["", "平均MAE", f"{avg_mae:.4f}"])
        perf_table.append(["", "平均R²", f"{avg_r2:.4f}"])
        perf_table.append(["", "预测步数", f"{FORECAST_HORIZON}"])
        perf_table.append(["", "总训练样本", f"{sum([res['train_samples'] for res in results])}"])
        perf_table.append(["", "总测试样本", f"{sum([res['test_samples'] for res in results])}"])

    # 添加各站点性能
    perf_table.append(["", "", ""])  # 空行分隔
    perf_table.append(["站点性能", "站点名称", "R² | RMSE | MAE"])

    for res in results:
        station = res['station']
        r2 = res['r2']
        rmse = res['rmse']
        mae = res['mae']
        perf_table.append(["", station, f"{r2:.4f} | {rmse:.4f} | {mae:.4f}"])

    # 按时间段性能
    perf_table.append(["", "", ""])  # 空行分隔
    perf_table.append(["时间段性能", "时间段", "平均R²"])

    if results and 'period_metrics' in results[0]:
        periods = ['1-6h', '7-12h', '13-18h', '19-24h']
        period_r2_dict = {period: [] for period in periods}

        for res in results:
            for period in periods:
                if period in res['period_metrics']:
                    period_r2_dict[period].append(res['period_metrics'][period]['r2'])

        for period in periods:
            if period_r2_dict[period]:
                avg_r2 = np.mean(period_r2_dict[period])
                chinese_period = period.replace('h', '小时')
                perf_table.append(["", chinese_period, f"{avg_r2:.4f}"])

    # 打印性能表格
    print("\n" + "="*90)
    print("表 13  模型性能评估结果")
    print("="*90)

    max_cols = [0, 0, 0]
    for row in perf_table:
        for i, cell in enumerate(row):
            max_cols[i] = max(max_cols[i], len(str(cell)))

    for i, row in enumerate(perf_table):
        if i == 0:
            print("| {:<{}} | {:<{}} | {:<{}} |".format(
                row[0], max_cols[0], row[1], max_cols[1], row[2], max_cols[2]
            ))
            print("|{}+{}+{}|".format(
                "-" * (max_cols[0] + 2),
                "-" * (max_cols[1] + 2),
                "-" * (max_cols[2] + 2)
            ))
        else:
            print("| {:<{}} | {:<{}} | {:<{}} |".format(
                row[0], max_cols[0], row[1], max_cols[1], row[2], max_cols[2]
            ))

    print("="*90)

    # 保存为文件
    perf_df = pd.DataFrame(perf_table[1:], columns=perf_table[0])
    perf_df.to_csv("model_performance_table.csv", index=False, encoding="utf-8-sig")

    # 保存为Markdown
    with open("model_performance_table.md", "w", encoding="utf-8") as f:
        f.write("# 表 13  模型性能评估结果\n\n")
        f.write("| 类别 | 参数名称 | 参数值 |\n")
        f.write("|---|---|---|\n")
        for row in perf_table[1:]:
            f.write(f"| {row[0]} | {row[1]} | {row[2]} |\n")

    print(f"\n性能表格已保存到:")
    print(f"  - model_performance_table.md")
    print(f"  - model_performance_table.csv")

# 调用生成性能表格函数
generate_performance_table(results)

