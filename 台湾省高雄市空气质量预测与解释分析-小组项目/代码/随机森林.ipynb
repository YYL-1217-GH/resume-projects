#%%
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import r2_score, mean_squared_error
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
import warnings

# 忽略性能警告
warnings.simplefilter("ignore", category=pd.errors.PerformanceWarning)
# ---------------------- 1. 配置参数 ----------------------
TARGET_STATIONS = ["Zuoying", "Meinong", "Linyuan", "Qianjin", "Xiaogang"]  # 5个站点
WINDOW_HOURS = 48  # 过去48小时
PREDICT_HOURS = 24  # 未来24小时

# ---------------------- 2. 数据加载与预处理（核心：隔离字符串列） ----------------------
df = pd.read_csv("D:/桌面/高雄市空气污染源数据.csv")  # 替换为你的数据路径
df["date"] = pd.to_datetime(df["date"])
df = df.sort_values(["sitename", "date"]).reset_index(drop=True)

# 仅保留目标5个站点的数据
df = df[df["sitename"].isin(TARGET_STATIONS)]

# ========== 关键修复：严格分离数值列和字符串列 ==========
# 1. 筛选纯数值列（排除sitename/date等字符串/时间列）
numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
# 2. 仅保留必要列：时间（用于排序）、站点（用于分组）、数值特征
df_core = df[["date", "sitename"] + numeric_cols].copy()

# 强制转换数值列为浮点型，非数值转NaN
for col in numeric_cols:
    df_core[col] = pd.to_numeric(df_core[col], errors="coerce")

# 多层级缺失值填充（彻底解决NaN）
# 步骤1：按站点+小时分组填充（适配小时规律）
df_core[numeric_cols] = df_core.groupby(["sitename", df_core["date"].dt.hour])[numeric_cols].transform(
    lambda x: x.fillna(x.median())
)
# 步骤2：兜底填充（全局中位数）
df_core[numeric_cols] = df_core[numeric_cols].fillna(df_core[numeric_cols].median())
# 步骤3：强制删除剩余NaN行（极端情况）
df_core = df_core.dropna(subset=numeric_cols)

# 时间特征编码（仅生成数值型时间特征）
df_core["hour"] = df_core["date"].dt.hour
df_core["month"] = df_core["date"].dt.month
df_core["dayofweek"] = df_core["date"].dt.dayofweek
df_core["hour_sin"] = np.sin(2 * np.pi * df_core["hour"] / 24)
df_core["hour_cos"] = np.cos(2 * np.pi * df_core["hour"] / 24)
df_core["month_sin"] = np.sin(2 * np.pi * df_core["month"] / 12)
df_core["month_cos"] = np.cos(2 * np.pi * df_core["month"] / 12)

# 新增：站点编码（将字符串站点名转为数值型，避免混入特征）
station_mapping = {name: idx for idx, name in enumerate(TARGET_STATIONS)}
df_core["station_code"] = df_core["sitename"].map(station_mapping)  # 数值编码：0-4

# ---------------------- 3. 特征工程（仅用数值特征） ----------------------
def create_48h_window_table(df, target_col="aqi", window_hours=WINDOW_HOURS):
    wide_df = df.copy()
    # 核心特征：数值列 + 数值型时间特征 + 站点编码（无字符串）
    core_feats = numeric_cols + ["hour_sin", "hour_cos", "month_sin", "month_cos", "station_code"]
    # 排除目标列和无关列
    core_feats = [f for f in core_feats if f not in [target_col, "status"]]

    # 关键滞后点（48小时窗口）
    key_lags = [1, 3, 6, 12, 24, 36, 48]
    for feat in core_feats:
        for lag in key_lags:
            wide_df[f"{feat}_lag{lag}"] = wide_df.groupby("sitename")[feat].shift(lag)
        # 48小时统计特征
        wide_df[f"{feat}_48h_mean"] = wide_df.groupby("sitename")[feat].shift(1).rolling(window=window_hours).mean()
        wide_df[f"{feat}_48h_std"] = wide_df.groupby("sitename")[feat].shift(1).rolling(window=window_hours).std()

    # 5个站点的协同特征（仅数值型）
    for station in TARGET_STATIONS:
        for feat in ["pm2.5", "windspeed", "winddirection"]:
            if feat in wide_df.columns:
                # 提取目标站点的特征并改名
                station_feat = df[df["sitename"] == station][["date", feat]].rename(columns={feat: f"{station}_{feat}"})
                wide_df = pd.merge(wide_df, station_feat, on="date", how="left")
                # 填充协同特征的NaN
                wide_df[f"{station}_{feat}"] = wide_df[f"{station}_{feat}"].fillna(wide_df[f"{station}_{feat}"].median())

    # 最终清理：删除窗口特征导致的NaN行 + 强制填充剩余NaN
    wide_df = wide_df.dropna(subset=core_feats)
    wide_df = wide_df.fillna(wide_df.median())

    # ========== 关键：仅筛选数值型特征列 ==========
    X_cols = [col for col in wide_df.columns if col not in ["date", "sitename", target_col]
              and wide_df[col].dtype in [np.float64, np.float32, np.int64, np.int32]]
    return wide_df, X_cols

# 生成特征表（确保无字符串列）
wide_df, X_cols = create_48h_window_table(df_core)
print(f"特征表形状：{wide_df.shape}，特征列数：{len(X_cols)}")
print(f"特征列是否全为数值型：{all(wide_df[X_cols].dtype in [np.float64, np.float32, np.int64, np.int32] for col in X_cols)}")
print(f"是否存在NaN：{wide_df[X_cols].isnull().any().any()}")  # 验证：应输出False

# ---------------------- 4. 时间划分+PCA（无字符串干扰） ----------------------
time_split_idx = int(0.8 * len(wide_df))
train_data = wide_df.iloc[:time_split_idx].reset_index(drop=True)
test_data = wide_df.iloc[time_split_idx:].reset_index(drop=True)

# 分离特征和目标变量（仅数值）
X_train, y_train = train_data[X_cols], train_data["aqi"]
X_test, y_test = test_data[X_cols], test_data["aqi"]

# 特征标准化（仅数值特征）
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train).astype(np.float32)
X_test_scaled = scaler.transform(X_test).astype(np.float32)

# 强制替换极端值（如inf）为0
X_train_scaled = np.nan_to_num(X_train_scaled, nan=0.0, posinf=0.0, neginf=0.0)
X_test_scaled = np.nan_to_num(X_test_scaled, nan=0.0, posinf=0.0, neginf=0.0)

# PCA降维
pca = PCA(n_components=0.95, random_state=42)
X_train_pca = pca.fit_transform(X_train_scaled)
X_test_pca = pca.transform(X_test_scaled)
print(f"PCA降维后特征数：{X_train_pca.shape[1]}（原特征数：{X_train_scaled.shape[1]}）")

# ---------------------- 5. 模型训练 ----------------------
rf_model = RandomForestRegressor(
    n_estimators=100,
    max_depth=10,
    min_samples_split=10,
    random_state=42,
    n_jobs=-1,
    max_features="sqrt"
)
rf_model.fit(X_train_pca, y_train)

# 测试集评估
y_test_pred = rf_model.predict(X_test_pca)
print(f"\n测试集 R²：{r2_score(y_test, y_test_pred):.4f}")
print(f"测试集 RMSE：{np.sqrt(mean_squared_error(y_test, y_test_pred)):.4f}")

# ---------------------- 6. 预测未来24小时（适配5个站点，无字符串） ----------------------
def predict_next_24h_per_station(model, scaler, pca, df_full, station_name, window_hours=WINDOW_HOURS):
    """按单个站点预测未来24小时（仅数值特征）"""
    # 提取该站点的所有数据（仅数值）
    station_df = df_full[df_full["sitename"] == station_name].reset_index(drop=True)
    # 取最后48小时数据作为输入窗口
    last_48h_data = station_df.tail(window_hours).reset_index(drop=True)

    predictions = []
    current_window = last_48h_data.copy()
    core_feats = numeric_cols + ["hour_sin", "hour_cos", "month_sin", "month_cos", "station_code"]
    core_feats = [f for f in core_feats if f not in ["aqi", "status"]]
    key_lags = [1, 3, 6, 12, 24, 36, 48]

    for hour in range(PREDICT_HOURS):
        # 构建当前输入特征（仅数值，无字符串）
        current_input = current_window.iloc[-1:][X_cols].fillna(current_window[X_cols].median())
        # 强制转为数值型
        current_input = current_input.astype(np.float32)
        current_input_scaled = scaler.transform(current_input)
        current_input_scaled = np.nan_to_num(current_input_scaled, nan=0.0)
        current_input_pca = pca.transform(current_input_scaled)

        # 预测AQI
        pred_aqi = model.predict(current_input_pca)[0]
        predictions.append(pred_aqi)

        # 滚动更新窗口（仅数值特征）
        last_date = current_window["date"].max()
        next_date = last_date + pd.Timedelta(hours=1)
        next_hour = next_date.hour
        next_month = next_date.month
        station_code = station_mapping[station_name]  # 数值编码

        # 构建下一小时行（仅数值+时间，无字符串）
        next_row = pd.DataFrame({
            "date": [next_date],
            "sitename": [station_name],  # 仅用于标识，不参与建模
            "station_code": [station_code],  # 数值编码
            "aqi": [pred_aqi],
            "hour": [next_hour],
            "month": [next_month],
            "dayofweek": [next_date.dayofweek],
            "hour_sin": [np.sin(2 * np.pi * next_hour / 24)],
            "hour_cos": [np.cos(2 * np.pi * next_hour / 24)],
            "month_sin": [np.sin(2 * np.pi * next_month / 12)],
            "month_cos": [np.cos(2 * np.pi * next_month / 12)]
        })

        # 填充核心数值特征和滞后特征
        for feat in core_feats:
            if feat in current_window.columns:
                next_row[feat] = current_window[feat].iloc[-1]
            else:
                next_row[feat] = 0.0
            # 更新滞后特征
            for lag in key_lags:
                lag_col = f"{feat}_lag{lag}"
                if lag == 1:
                    next_row[lag_col] = current_window[feat].iloc[-1] if feat in current_window.columns else pred_aqi
                else:
                    prev_lag_col = f"{feat}_lag{lag-1}" if (lag-1) in key_lags else f"{feat}_lag1"
                    next_row[lag_col] = current_window[prev_lag_col].iloc[-1] if prev_lag_col in current_window.columns else 0.0
            # 更新统计特征
            window_feats = current_window[feat].tolist()[-window_hours+1:] + [next_row[f"{feat}_lag1"].iloc[0]]
            next_row[f"{feat}_48h_mean"] = np.mean(window_feats)
            next_row[f"{feat}_48h_std"] = np.std(window_feats)

        # 填充其他站点协同特征（仅数值）
        for s in TARGET_STATIONS:
            for feat in ["pm2.5", "windspeed", "winddirection"]:
                col = f"{s}_{feat}"
                next_row[col] = current_window[col].median() if col in current_window.columns else 0.0

        # 强制填充所有NaN并转为数值型
        next_row = next_row.fillna(0.0).astype({col: np.float32 for col in next_row.columns if col not in ["date", "sitename"]})

        # 滚动窗口
        current_window = pd.concat([current_window.iloc[1:], next_row], ignore_index=True)

    # 生成时间索引
    future_dates = pd.date_range(start=last_date + pd.Timedelta(hours=1), periods=PREDICT_HOURS, freq="H")
    # 返回该站点的预测结果
    return pd.DataFrame({
        "date": future_dates,
        "sitename": station_name,
        "predicted_aqi": predictions
    })

# ---------------------- 7. 批量预测5个站点 ----------------------
all_stations_pred = []
for station in TARGET_STATIONS:
    print(f"\n正在预测 {station} 站点未来24小时AQI...")
    station_pred = predict_next_24h_per_station(rf_model, scaler, pca, wide_df, station)
    all_stations_pred.append(station_pred)

# 合并所有站点的预测结果
final_pred = pd.concat(all_stations_pred, ignore_index=True)

# ---------------------- 8. 输出与保存 ----------------------
print("\n=== 5个站点未来24小时AQI预测结果（前10条） ===")
print(final_pred.head(10))

# 保存完整结果（按站点+时间排序）
final_pred = final_pred.sort_values(["sitename", "date"]).reset_index(drop=True)
final_pred.to_csv("5_stations_24h_aqi_prediction.csv", index=False)
print("\n完整预测结果已保存至 5_stations_24h_aqi_prediction.csv")

# 按站点打印汇总
for station in TARGET_STATIONS:
    station_data = final_pred[final_pred["sitename"] == station]
    print(f"\n{station} 站点未来24小时AQI统计：")
    print(f"均值：{station_data['predicted_aqi'].mean():.2f}")
    print(f"最大值：{station_data['predicted_aqi'].max():.2f}")
    print(f"最小值：{station_data['predicted_aqi'].min():.2f}")
#%%
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.multioutput import MultiOutputRegressor
import warnings
from datetime import datetime, timedelta
import gc  # 垃圾回收

# 添加matplotlib导入
import matplotlib.pyplot as plt
import matplotlib.patches as patches
from matplotlib.patches import FancyBboxPatch

# 设置中文字体
plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

# 忽略性能警告
warnings.simplefilter("ignore", category=pd.errors.PerformanceWarning)

# ---------------------- 1. 配置参数 ----------------------
TARGET_STATIONS = ["Zuoying", "Meinong", "Linyuan", "Qianjin", "Xiaogang"]  # 5个站点
LOOKBACK_HOURS = 48  # 历史窗口小时数
FORECAST_HORIZON = 24  # 预测小时数

# ---------------------- 2. 数据加载与预处理 ----------------------
print(f"{datetime.now().strftime('%H:%M:%S')} - 开始加载数据...")

# 定义核心特征列
core_features = ['aqi', 'pm2.5', 'pm10', 'co', 'o3', 'so2', 'no2',
                 'temperature', 'humidity', 'windspeed', 'winddirection']

# 读取数据（优化读取方式）
try:
    # 先读取列名，避免重复读取
    df_columns = pd.read_csv("D:/桌面/高雄市空气污染源数据.csv", nrows=0).columns.tolist()
    use_cols = ['date', 'sitename'] + [col for col in core_features if col in df_columns]

    # 读取数据并立即处理非数值值
    df = pd.read_csv("D:/桌面/高雄市空气污染源数据.csv", usecols=use_cols)
    print(f"{datetime.now().strftime('%H:%M:%S')} - 数据加载完成，原始形状: {df.shape}")
except Exception as e:
    print(f"读取数据时出错: {e}")
    # 如果出错，读取所有列然后筛选
    df = pd.read_csv("D:/桌面/高雄市空气污染源数据.csv")
    df = df[['date', 'sitename'] + [col for col in core_features if col in df.columns]]
    print(f"{datetime.now().strftime('%H:%M:%S')} - 数据加载完成，原始形状: {df.shape}")

# 仅保留目标站点
df = df[df['sitename'].isin(TARGET_STATIONS)]
print(f"{datetime.now().strftime('%H:%M:%S')} - 筛选后形状: {df.shape}")

# 转换日期列
df["date"] = pd.to_datetime(df["date"], errors='coerce')
df = df.sort_values(["sitename", "date"]).reset_index(drop=True)

# 全局替换非数值值（关键修复）
# 定义需要替换的非数值标记
non_numeric_markers = ['ND', 'nd', 'N/A', 'na', '', ' ', 'None', 'none']

# 先将所有核心特征列中的非数值标记替换为NaN
for col in core_features:
    if col in df.columns:
        # 替换所有非数值标记
        df[col] = df[col].replace(non_numeric_markers, np.nan)
        # 强制转换为数值类型（失败则设为NaN）
        df[col] = pd.to_numeric(df[col], errors='coerce')

# ---------------------- 3. 按站点分别处理 ----------------------
print(f"\n{datetime.now().strftime('%H:%M:%S')} - 开始按站点处理数据...")

def create_multi_step_features(station_df, station_name):
    """为单个站点创建多步预测特征"""
    print(f"  处理站点: {station_name}")

    # 复制数据
    station_data = station_df.copy()

    # 确定数值列
    numeric_cols = station_data.select_dtypes(include=[np.number]).columns.tolist()
    print(f"    初始数值列: {numeric_cols}")

    # 处理缺失值（确保只处理数值列）
    for col in numeric_cols:
        # 再次确认数值类型（双重保险）
        station_data[col] = pd.to_numeric(station_data[col], errors='coerce')
        # 使用中位数填充（跳过全为NaN的列）
        if not station_data[col].isna().all():
            station_data[col] = station_data[col].fillna(station_data[col].median())
        else:
            station_data[col] = 0  # 全为NaN时填充0

    # 添加时间特征
    station_data['hour'] = station_data['date'].dt.hour
    station_data['month'] = station_data['date'].dt.month
    station_data['day_of_week'] = station_data['date'].dt.dayofweek

    # 周期性时间特征
    station_data['hour_sin'] = np.sin(2 * np.pi * station_data['hour'] / 24)
    station_data['hour_cos'] = np.cos(2 * np.pi * station_data['hour'] / 24)
    station_data['month_sin'] = np.sin(2 * np.pi * station_data['month'] / 12)
    station_data['month_cos'] = np.cos(2 * np.pi * station_data['month'] / 12)

    # 是否为周末
    station_data['is_weekend'] = station_data['day_of_week'].apply(lambda x: 1 if x >= 5 else 0)

    # 滞后特征 - 为关键特征创建滞后
    key_features = ['aqi', 'pm2.5', 'windspeed', 'temperature', 'humidity']
    key_features = [f for f in key_features if f in numeric_cols and not station_data[f].isna().all()]

    # 创建滞后点
    lags = [1, 2, 3, 6, 12, 24, 48]  # 减少滞后点数量

    for feat in key_features:
        for lag in lags:
            if lag < len(station_data):
                station_data[f"{feat}_lag{lag}"] = station_data[feat].shift(lag)
                # 填充滞后特征的NaN
                station_data[f"{feat}_lag{lag}"] = station_data[f"{feat}_lag{lag}"].fillna(station_data[feat].median())

    # 移动统计特征（简化，添加min_periods=1确保有值）
    windows = [12, 24, 48]  # 减少窗口数量
    for feat in ['aqi', 'pm2.5']:
        if feat in station_data.columns and not station_data[feat].isna().all():
            for window in windows:
                # 确保窗口不超过数据长度
                if window <= len(station_data):
                    station_data[f"{feat}_mean{window}"] = station_data[feat].rolling(
                        window=window, min_periods=1).mean().fillna(station_data[feat].median())

    # 差分特征
    for feat in ['aqi']:
        if feat in station_data.columns and not station_data[feat].isna().all():
            station_data[f"{feat}_diff1"] = station_data[feat].diff(1).fillna(0)
            station_data[f"{feat}_diff24"] = station_data[feat].diff(24).fillna(0)

    # 删除仍存在的NaN行（最后一道保障）
    station_data = station_data.dropna(how='any')

    # 确保至少有数据
    if len(station_data) < 100:
        print(f"    警告: 站点 {station_name} 处理后数据不足，跳过")
        return None, []

    # 选择特征列（只选择一部分特征）
    X_cols = []
    all_potential_cols = [
        col for col in station_data.columns
        if col not in ['date', 'sitename', 'aqi']
        and station_data[col].dtype in [np.float64, np.float32, np.int64, np.int32]
        and not station_data[col].isna().all()
    ]

    # 只选择前30个特征（减少特征数量）
    X_cols = all_potential_cols[:30]

    print(f"    创建了 {len(X_cols)} 个有效特征")
    return station_data, X_cols

# 存储每个站点的数据
station_data_dict = {}
station_features_dict = {}

for station in TARGET_STATIONS:
    station_df = df[df['sitename'] == station].reset_index(drop=True)
    if len(station_df) > 100:  # 确保有足够的数据
        processed_data, X_cols = create_multi_step_features(station_df, station)
        if processed_data is not None and len(processed_data) > 100 and len(X_cols) > 0:
            station_data_dict[station] = processed_data
            station_features_dict[station] = X_cols
        else:
            print(f"  警告: 站点 {station} 处理后无有效数据，跳过")
    else:
        print(f"  警告: 站点 {station} 原始数据不足，跳过")

# ---------------------- 4. 按站点分别训练和评估（多步预测） ----------------------
print(f"\n{datetime.now().strftime('%H:%M:%S')} - 开始按站点训练多步预测模型...")

results = []

for station in TARGET_STATIONS:
    if station not in station_data_dict:
        continue

    print(f"\n  训练站点: {station}")
    station_data = station_data_dict[station]
    X_cols = station_features_dict[station]

    # 准备多步预测数据
    X_multi = []
    y_multi = []

    # 确保有足够的数据用于滑动窗口
    required_length = LOOKBACK_HOURS + FORECAST_HORIZON
    if len(station_data) < required_length:
        print(f"    警告: 站点 {station} 数据不足，无法创建多步预测数据")
        continue

    for i in range(len(station_data) - required_length):
        # 输入特征：过去LOOKBACK_HOURS小时的所有特征
        X_window = station_data.iloc[i:i+LOOKBACK_HOURS][X_cols].values.flatten()

        # 输出：未来FORECAST_HORIZON小时的AQI
        y_window = station_data.iloc[i+LOOKBACK_HOURS:i+LOOKBACK_HOURS+FORECAST_HORIZON]['aqi'].values

        # 确保无NaN值
        if not np.isnan(X_window).any() and not np.isnan(y_window).any():
            X_multi.append(X_window)
            y_multi.append(y_window)

    if len(X_multi) == 0:
        print(f"    警告: 站点 {station} 无有效训练数据")
        continue

    X_multi = np.array(X_multi)
    y_multi = np.array(y_multi)

    print(f"    多步预测数据形状: X={X_multi.shape}, y={y_multi.shape}")

    # 时间划分 (80%训练，20%测试)
    split_idx = int(0.8 * len(X_multi))
    if split_idx == 0 or split_idx == len(X_multi):
        print(f"    警告: 站点 {station} 数据量不足以划分训练测试集")
        continue

    X_train = X_multi[:split_idx]
    y_train = y_multi[:split_idx]
    X_test = X_multi[split_idx:]
    y_test = y_multi[split_idx:]

    print(f"    训练样本: {len(X_train)}, 测试样本: {len(X_test)}")

    # 标准化
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    X_test_scaled = scaler.transform(X_test)

    # 使用更少的PCA成分
    try:
        pca = PCA(n_components=0.85, random_state=42)  # 保留85%方差
        X_train_pca = pca.fit_transform(X_train_scaled)
        X_test_pca = pca.transform(X_test_scaled)
        print(f"    原始特征数: {X_train.shape[1]}, PCA后特征数: {X_train_pca.shape[1]}")
    except Exception as e:
        print(f"    PCA失败: {e}，使用原始特征")
        X_train_pca = X_train_scaled
        X_test_pca = X_test_scaled

    # 训练多输出随机森林模型
    rf_model = MultiOutputRegressor(
        RandomForestRegressor(
            n_estimators=50,  # 减少树的数量
            max_depth=8,      # 减小深度
            min_samples_split=15,
            min_samples_leaf=8,
            random_state=42,
            n_jobs=-1,
            max_features=0.5   # 减少特征比例
        ),
        n_jobs=-1
    )

    rf_model.fit(X_train_pca, y_train)

    # 预测
    y_train_pred = rf_model.predict(X_train_pca)
    y_test_pred = rf_model.predict(X_test_pca)

    # 计算指标（按预测步分别计算，然后平均）
    test_r2_scores = []
    test_rmse_scores = []
    test_mae_scores = []

    for step in range(FORECAST_HORIZON):
        # 确保该步有数据
        if len(y_test[:, step]) > 0:
            step_r2 = r2_score(y_test[:, step], y_test_pred[:, step])
            step_rmse = np.sqrt(mean_squared_error(y_test[:, step], y_test_pred[:, step]))
            step_mae = mean_absolute_error(y_test[:, step], y_test_pred[:, step])

            test_r2_scores.append(step_r2)
            test_rmse_scores.append(step_rmse)
            test_mae_scores.append(step_mae)

    # 处理空列表情况
    if not test_r2_scores:
        print(f"    警告: 站点 {station} 无有效评估数据")
        continue

    # 整体指标（所有预测步的平均）
    overall_rmse = np.mean(test_rmse_scores)
    overall_mae = np.mean(test_mae_scores)
    overall_r2 = np.mean(test_r2_scores)

    # 按时间段计算指标
    period_metrics = {}
    periods = {
        '1-6h': (0, 6),
        '7-12h': (6, 12),
        '13-18h': (12, 18),
        '19-24h': (18, 24)
    }

    for period_name, (start, end) in periods.items():
        period_r2 = np.mean(test_r2_scores[start:end]) if end <= len(test_r2_scores) else 0
        period_rmse = np.mean(test_rmse_scores[start:end]) if end <= len(test_rmse_scores) else 0
        period_mae = np.mean(test_mae_scores[start:end]) if end <= len(test_mae_scores) else 0
        period_metrics[period_name] = {
            'r2': period_r2,
            'rmse': period_rmse,
            'mae': period_mae
        }

    # 存储结果
    results.append({
        'station': station,
        'train_samples': len(X_train),
        'test_samples': len(X_test),
        'rmse': overall_rmse,
        'mae': overall_mae,
        'r2': overall_r2,
        'rmse_by_step': test_rmse_scores,
        'mae_by_step': test_mae_scores,
        'r2_by_step': test_r2_scores,
        'period_metrics': period_metrics,
        'model': rf_model,
        'scaler': scaler,
        'pca': pca if 'pca' in locals() else None,
        'X_cols': X_cols,
        'lookback': LOOKBACK_HOURS,
        # 保存测试集数据用于绘图
        'y_test_sample': y_test[0] if len(y_test) > 0 else None,
        'y_test_pred_sample': y_test_pred[0] if len(y_test_pred) > 0 else None
    })

    print(f"    整体 RMSE: {overall_rmse:.4f}, MAE: {overall_mae:.4f}, R²: {overall_r2:.4f}")
    print(f"    1-6h R²: {period_metrics['1-6h']['r2']:.4f}, 19-24h R²: {period_metrics['19-24h']['r2']:.4f}")

    # 释放内存
    del X_train, X_test, y_train, y_test, X_train_scaled, X_test_scaled
    if 'X_train_pca' in locals():
        del X_train_pca, X_test_pca
    gc.collect()

# ---------------------- 5. 输出结果表格 ----------------------
print(f"\n{datetime.now().strftime('%H:%M:%S')} - 生成结果表格...")
print("\n" + "="*80)
print("站点名称    训练样本    测试样本    RMSE    MAE    R2")
print("-"*80)

for res in results:
    print(f"{res['station']:10} {res['train_samples']:9} {res['test_samples']:9} {res['rmse']:8.4f} {res['mae']:7.4f} {res['r2']:7.4f}")

# 计算平均指标
if results:
    avg_rmse = np.mean([res['rmse'] for res in results])
    avg_mae = np.mean([res['mae'] for res in results])
    avg_r2 = np.mean([res['r2'] for res in results])

    print("-"*80)
    print(f"{'平均指标':10} {'-':9} {'-':9} {avg_rmse:8.4f} {avg_mae:7.4f} {avg_r2:7.4f}")
    print("="*80)

# ---------------------- 6. 输出按时间段的结果表格 ----------------------
print(f"\n{datetime.now().strftime('%H:%M:%S')} - 按时间段预测结果...")
print("\n" + "="*90)
print("时间段    站点名称    RMSE    MAE    R2")
print("-"*90)

periods_list = ['1-6h', '7-12h', '13-18h', '19-24h']
for period in periods_list:
    print(f"\n{period}:")
    for res in results:
        station = res['station']
        metrics = res['period_metrics'][period]
        print(f"  {station:10} {metrics['rmse']:8.4f} {metrics['mae']:7.4f} {metrics['r2']:7.4f}")

print("="*90)

# ---------------------- 7. 预测未来24小时 ----------------------
print(f"\n{datetime.now().strftime('%H:%M:%S')} - 开始预测未来24小时...")

def predict_future_24h_multi_step(station, model_info):
    """多步预测单个站点未来24小时"""
    station_data = station_data_dict.get(station)
    if station_data is None:
        return None

    # 获取模型组件
    model = model_info['model']
    scaler = model_info['scaler']
    pca = model_info['pca']
    X_cols = model_info['X_cols']
    lookback = model_info['lookback']

    # 获取最近数据
    recent_data = station_data.tail(lookback + 24).reset_index(drop=True).copy()

    if len(recent_data) < lookback:
        print(f"    警告: 站点 {station} 最近数据不足")
        return None

    # 准备输入：过去lookback小时的数据
    last_window = recent_data.iloc[-lookback:][X_cols].values.flatten().reshape(1, -1)

    # 标准化
    last_window_scaled = scaler.transform(last_window)

    # PCA转换（如果有）
    if pca is not None:
        last_window_pca = pca.transform(last_window_scaled)
    else:
        last_window_pca = last_window_scaled

    # 一次性预测未来24小时
    predictions = model.predict(last_window_pca)[0]
    predictions = np.maximum(predictions, 0)  # AQI不能为负

    # 生成日期
    last_date = recent_data['date'].max()
    future_dates = [last_date + timedelta(hours=i+1) for i in range(FORECAST_HORIZON)]

    return pd.DataFrame({
        'date': future_dates,
        'sitename': station,
        'predicted_aqi': predictions
    })

# 为每个站点预测
future_predictions = []
for res in results:
    station = res['station']
    print(f"  预测站点: {station}")
    pred_df = predict_future_24h_multi_step(station, res)
    if pred_df is not None:
        future_predictions.append(pred_df)

# 合并预测结果
if future_predictions:
    all_predictions = pd.concat(future_predictions, ignore_index=True)

    # 保存预测结果
    output_file = "5_stations_24h_aqi_predictions_multi_step.csv"
    all_predictions.to_csv(output_file, index=False)

    print(f"\n{datetime.now().strftime('%H:%M:%S')} - 多步预测完成!")
    print(f"  结果已保存到: {output_file}")

    # 显示预测统计
    print("\n=== 未来24小时AQI多步预测统计 ===")
    for station in TARGET_STATIONS:
        station_pred = all_predictions[all_predictions['sitename'] == station]
        if len(station_pred) > 0:
            print(f"\n{station}:")
            print(f"  平均AQI: {station_pred['predicted_aqi'].mean():.2f}")
            print(f"  最高AQI: {station_pred['predicted_aqi'].max():.2f}")
            print(f"  最低AQI: {station_pred['predicted_aqi'].min():.2f}")
            print(f"  变化范围: {station_pred['predicted_aqi'].max() - station_pred['predicted_aqi'].min():.2f}")

# ---------------------- 8. 保存详细结果 ----------------------
if results:
    # 保存每个站点的详细指标
    detailed_results = []
    for res in results:
        for step in range(len(res['rmse_by_step'])):
            detailed_results.append({
                'station': res['station'],
                'step': step + 1,
                'rmse': res['rmse_by_step'][step],
                'mae': res['mae_by_step'][step],
                'r2': res['r2_by_step'][step]
            })

    detailed_df = pd.DataFrame(detailed_results)
    detailed_df.to_csv("detailed_stepwise_metrics.csv", index=False)
    print(f"\n详细分步指标已保存到: detailed_stepwise_metrics.csv")

